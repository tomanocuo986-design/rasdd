# --- AI assistant (choose one) ---
# Local / in-network model through any OpenAI-compatible server (Ollama, vLLM, LM Studio): data never leaves your network
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_API_KEY=
# Or Google Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- Central database + sync (optional; the app works offline without them) ---
# DATABASE_URL=postgres://rasd:password@db:5432/rasd
# DATABASE_SSL=require                 # for managed Postgres (RDS / Azure Database)
# RASD_DATA_KEY=                       # openssl rand -base64 32  -> column-level encryption key (keep in KMS / Key Vault)
# RASD_DATA_KEY_PREV=                  # old key(s), comma-separated, kept while rotating
# RASD_API_TOKENS=auditor1:<random 32+ chars>,auditor2:<random 32+ chars>
# RASD_MAX_PAYLOAD_MB=25
# POSTGRES_PASSWORD=                   # docker-compose only

# --- تسجيل الدخول (رقم وظيفي + باسورد) ---
# AUTH_SECRET=                 # openssl rand -hex 32  (اختياري؛ إن تُرك فارغاً يُولَّد تلقائياً داخل ./data)
# AUTH_DATA_DIR=./data         # مكان حفظ المستخدمين (إن لم يوجد DATABASE_URL)
# مع DATABASE_URL تُحفظ الحسابات في PostgreSQL بشكل دائم (مطلوب على Render لأن ملفات الخدمة تُمسح عند كل نشر)
