# --- AI assistant (choose one) ---
# Local / in-network model through any OpenAI-compatible server (Ollama, vLLM, LM Studio): data never leaves your network
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_API_KEY=
# Or Google Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- Central database + sync (optional; the app works offline without them) ---
# DATABASE_URL=postgres://rasd:password@db:5432/rasd
# DATABASE_SSL=require                 # TLS مع التحقق من الشهادة (الافتراضي الآمن). no-verify = بلا تحقق (اضطراراً فقط)
# DATABASE_SSL_CA=                     # شهادة جهة داخلية (نص PEM أو مسار ملف) إن لم تكن الشهادة من جهة معروفة
# RASD_DATA_KEY=                       # openssl rand -base64 32  -> column-level encryption key (keep in KMS / Key Vault)
# RASD_DATA_KEY_PREV=                  # old key(s), comma-separated, kept while rotating
# RASD_API_TOKENS=auditor1:<random 32+ chars>,auditor2:<random 32+ chars>
# RASD_MAX_PAYLOAD_MB=25
# POSTGRES_PASSWORD=                   # docker-compose only

# --- تسجيل الدخول (رقم وظيفي + باسورد) ---
# AUTH_SECRET=                 # openssl rand -hex 32  (اختياري؛ إن تُرك فارغاً يُولَّد تلقائياً داخل ./data)
# AUTH_DATA_DIR=./data         # مكان حفظ المستخدمين (إن لم يوجد DATABASE_URL)
# مع DATABASE_URL تُحفظ الحسابات في PostgreSQL بشكل دائم (مطلوب على Render لأن ملفات الخدمة تُمسح عند كل نشر)

# --- الأدوار والتسجيل وسجل التدقيق ---
# RASD_ADMINS=1001,1002        # أرقام وظيفية بدور «مدير» (تتفوق على المخزَّن في قاعدة البيانات)
# RASD_REVIEWERS=2001          # أرقام وظيفية بدور «مراجع» (يقرأ سجل التدقيق)
# AUTH_REGISTRATION=invite     # invite (يتطلب AUTH_INVITE_CODE) | closed (الافتراضي إن لم يُضبط شيء) | open (تجارب فقط، ولا يسمح بتسجيل أرقام المدراء)
# AUTH_INVITE_CODE=            # رمز دعوة طويل وعشوائي: openssl rand -hex 16
# سجل التدقيق: مع DATABASE_URL يُحفظ في جدول rasd_audit_log بمشغّل يمنع التعديل والحذف؛ بدونها في ./data/audit-log.jsonl

# --- عنوان العميل وحدّ المحاولات ---
# TRUST_PROXY_HOPS=1           # عدد الوكلاء الموثوقين أمام الخادم (Render = 1). 0 = لا نثق بأي ترويسة
# TRUST_CF_CONNECTING_IP=1     # فعّله فقط إن كان Cloudflare هو الطريق الوحيد إلى الخادم
# مع DATABASE_URL تُحفظ عدّادات المحاولات الفاشلة في PostgreSQL (جدول rasd_fail_counters) فلا تُمسح عند إعادة التشغيل

# --- إضافة الأنظمة برابط (اختياري) ---
# المواقع المسموحة افتراضياً: mola.gov.jo و csb.gov.jo و mof.gov.jo و gtd.gov.jo و modee.gov.jo و portal.jordan.gov.jo و spac.gov.jo (docs/LEGAL_URL.ar.md)
# LEGAL_FETCH=off                         # تعطيل الميزة
# LEGAL_FETCH_EXTRA_HOSTS=pm.gov.jo       # نطاقات إضافية، يجب أن تنتهي بـ .gov.jo
# LEGAL_FETCH_MAX_MB=25                   # أقصى حجم للملف
# المكتبة الرسمية: الخادم يجلب أنظمة وتعليمات من قائمة روابط رسمية ويحتفظ بها في الذاكرة (docs/LEGAL_LIBRARY.ar.md)
# LEGAL_LIBRARY=off                       # تعطيل المكتبة الرسمية (تعطيل LEGAL_FETCH يعطلها أيضاً)
# LEGAL_LIBRARY_TTL_HOURS=24              # مدة بقاء النسخة قبل إعادة الجلب (1–720)
# LEGAL_CATALOG_EXTRA=[{"title":"اسم النظام","url":"https://…gov.jo/….pdf","site":"الجهة"}]   # بنود إضافية (JSON في سطر واحد)

# --- النسخة بدون إنترنت (docs/OFFLINE_PACKAGE.ar.md) ---
# زر «تحميل النسخة بدون إنترنت» ينزّل حزمة مشفّرة بكلمة مرور المستخدم. تُبنى وقت النشر: npm run build && npm run build:offline
# OFFLINE_PACKAGE=off                     # إخفاء الزر وتعطيل المسار
# OFFLINE_PACKAGE_DIR=./offline-dist      # مكان ناتج npm run build:offline
